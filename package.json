{
  "name": "dmarc-compass",
  "version": "0.1.0",
  "description": "Self-hosted DMARC and TLS-RPT report dashboard for Cloudflare Workers, D1 and Containers",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/wrangler.mjs dev",
    "deploy": "node scripts/wrangler.mjs deploy",
    "tail": "node scripts/wrangler.mjs tail",
    "demo": "node scripts/seed-demo.mjs --apply",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/*.test.ts\"",
    "vendor": "node scripts/vendor.mjs",
    "bench": "node scripts/bench.mjs",
    "build:node": "node scripts/build-node.mjs",
    "start:node": "npm run build:node && node dist/server.mjs",
    "e2e:docker": "node scripts/e2e/docker.mjs",
    "e2e:k8s": "node scripts/e2e/kubernetes.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^26.6.5",
    "chart.js": "^4.6.1",
    "esbuild": "^0.28.2",
    "leaflet": "^1.9.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.153.0"
  }
}
