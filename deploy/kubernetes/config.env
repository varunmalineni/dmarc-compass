# Not secret. The admin user, password and encryption key go in the Secret (see README.md).
#
# Behind an Ingress or load balancer that adds X-Forwarded-For and X-Forwarded-Proto, set this to true.
TRUST_PROXY=false
# The address people use, e.g. https://dmarc.example.com (used in links in alerts). Leave empty to use the request's.
PUBLIC_URL=
# Sign in over plain http:// (not needed behind HTTPS). Leave false.
ALLOW_INSECURE_HTTP=false
# DNS server for reverse lookups of sending IPs, if your cluster blocks public DNS (e.g. 10.96.0.10:53). Empty uses 1.1.1.1:53.
DNS_SERVER=
TZ=UTC
