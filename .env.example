# Copy to .env and fill in. Never commit .env.

# Sign-in for the dashboard. There is no default password. After first sign-in you can change both in
# Admin -> Account; the saved login then takes precedence over these two lines.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Encrypts the mailbox passwords stored in the database. Create with: openssl rand -base64 32
# Keep a copy: without it, saved mailbox passwords cannot be read.
CONFIG_ENCRYPTION_KEY=

# Behind a reverse proxy that adds X-Forwarded-For / X-Forwarded-Proto (nginx, Traefik, Caddy, an ingress):
# TRUST_PROXY=true
# The address people use, if the proxy does not pass the right host:
# PUBLIC_URL=https://dmarc.example.com

# http://localhost works in most browsers as is. To sign in over plain HTTP from another machine
# on a trusted network (not recommended beyond a trial):
# ALLOW_INSECURE_HTTP=true

# Slack Incoming Webhook (can also be added in Admin):
# SLACK_WEBHOOK_URL=
# DNS server used for reverse lookups of sending IPs (default 1.1.1.1:53), for networks that block it:
# DNS_SERVER=10.0.0.2:53
# TZ=Europe/Berlin

# The image to run. The default is the release this checkout was made for; to use another tag, or your own
# build, set it here (then: docker compose pull && docker compose up -d). Tags are listed in docs/self-hosting.md.
# DMARC_COMPASS_IMAGE=ghcr.io/varunmalineni/dmarc-compass:0.1.0
